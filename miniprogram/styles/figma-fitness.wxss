/* Figma「Mobile Fitness Booking App」设计令牌 - 春绿主色、浅灰底 */

page {
  --fg-bg: #f5f7fa;
  --fg-green-a: #a8e6cf;
  --fg-green-b: #4caf50;
  --fg-text: #111827;
  --fg-text-2: #6b7280;
  --fg-text-3: #9ca3af;
  --fg-card: #ffffff;
  --fg-radius-lg: 32rpx;
  --fg-radius-xl: 40rpx;
  --fg-shadow: 0 8rpx 32rpx rgba(17, 24, 39, 0.08);
  --fg-shadow-green: 0 12rpx 36rpx rgba(76, 175, 80, 0.25);
}

.figma-page-bg {
  background: var(--fg-bg);
  min-height: 100vh;
}

.figma-grad-hero {
  background: linear-gradient(145deg, var(--fg-green-a) 0%, var(--fg-green-b) 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 32rpx 28rpx 40rpx;
  color: #fff;
}

.figma-hero-h1 {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.figma-hero-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.figma-hero-stat {
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: var(--fg-radius-lg);
  padding: 28rpx 20rpx;
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
}

.figma-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.figma-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.figma-tabs-main {
  margin: -24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx;
  display: flex;
  gap: 8rpx;
  box-shadow: var(--fg-shadow);
  position: relative;
  z-index: 2;
}

.figma-tab-main {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg-text-2);
  border-radius: 20rpx;
}

.figma-tab-main.on {
  color: #fff;
  background: linear-gradient(90deg, var(--fg-green-a), var(--fg-green-b));
  box-shadow: var(--fg-shadow-green);
}

.figma-hint-blue {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #1e3a8a;
  line-height: 1.5;
}

.figma-card {
  background: var(--fg-card);
  border-radius: var(--fg-radius-lg);
  padding: 32rpx 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.figma-btn-grad {
  background: linear-gradient(90deg, var(--fg-green-a), var(--fg-green-b));
  color: #fff;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--fg-shadow-green);
}

.figma-avatar-grad {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, var(--fg-green-a), var(--fg-green-b));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  box-shadow: var(--fg-shadow-green);
  flex-shrink: 0;
}

.figma-tag-green {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 1rpx solid #a7f3d0;
}

.figma-tag-gray {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.figma-info-grad {
  background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(59, 130, 246, 0.3);
}
