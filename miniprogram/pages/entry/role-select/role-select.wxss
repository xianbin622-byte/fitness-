@import "../../../styles/figma-fitness.wxss";

page {
  background: #f4f5f7;
}

.page {
  min-height: 100vh;
}

.safe-wrap {
  padding: 22rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.logo-wrap {
  margin-top: 20rpx;
  margin-bottom: 56rpx;
  text-align: center;
}

.logo-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  margin: 0 auto 26rpx;
  background: linear-gradient(145deg, #9be7cf, #4caf50);
  color: #fff;
  font-size: 82rpx;
  line-height: 140rpx;
  text-align: center;
  box-shadow: 0 10rpx 32rpx rgba(76, 175, 80, 0.3);
}

.headline {
  display: block;
  font-size: 68rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #0f172a;
}

.headline-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  color: #6b7280;
}

.role-tip {
  display: block;
  text-align: center;
  color: #9ca3af;
  letter-spacing: 4rpx;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}

.card {
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  background: #eff1f5;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

.card.selected {
  background: #9be7cf;
  box-shadow: 0 10rpx 28rpx rgba(76, 175, 80, 0.25);
}

.card-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  min-height: 132rpx;
}

.card-text {
  flex: 1;
  padding-right: 24rpx;
}

.title {
  display: block;
  font-size: 50rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}

.desc {
  display: block;
  font-size: 38rpx;
  line-height: 1.5;
  color: #6b7280;
}

.icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0;
}

.icon-wrap.on {
  opacity: 1;
}

.icon-glyph {
  font-size: 36rpx;
  line-height: 1;
  color: #16a34a;
  font-weight: 700;
}

.continue-btn {
  margin-top: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #9be7cf, #41b84f);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  height: 96rpx;
  line-height: 96rpx;
}

.terms-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b7280;
}

.terms-link {
  font-size: 22rpx;
  color: #43a850;
  line-height: 1.7;
}

.terms {
  margin-top: 20rpx;
  text-align: center;
}
