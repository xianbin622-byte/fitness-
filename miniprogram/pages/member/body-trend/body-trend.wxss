.page {
  padding: 24rpx;
}

.title-sm {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.summary {
  display: flex;
  gap: 12rpx;
}

.item {
  flex: 1;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.value {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
}

.unit {
  font-size: 22rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tab {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe4ff;
  color: #6b7280;
  font-size: 24rpx;
}

.tab.on {
  background: #e0e7ff;
  color: #1d4ed8;
}

.canvas {
  width: 100%;
  height: 420rpx;
  background: #ffffff;
  border: 1rpx solid #eef2f7;
  border-radius: 14rpx;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
