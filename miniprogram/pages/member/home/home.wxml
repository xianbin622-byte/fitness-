<view class="page figma-page-bg safe-bottom">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">会员工作台</text>
    <text class="hero-sub">你好，{{userName}} · 当前教练：{{coachName}}</text>
  </view>

  <view class="figma-card level-card">
    <text class="card-title">运动等级</text>
    <view class="level-row">
      <text class="level-num">Lv {{fitness.level}}</text>
      <text class="level-exp">经验 {{fitness.exp}} / {{fitness.nextExp}} · 已完成课程 {{fitness.completedClasses}} · 体测条数 {{fitness.bodyRecords}}</text>
    </view>
    <view class="bar">
      <view class="bar-inner" style="width: {{ (fitness.nextExp > 0 ? (fitness.exp / fitness.nextExp) * 100 : 0) }}%;"></view>
    </view>
    <text class="sub-hint">完成课程、记录体测可提升等级与经验值。</text>
  </view>

  <view class="figma-info-grad">
    <text class="info-h">明日一日建议</text>
    <text class="info-p" wx:if="{{coachNotePreview}}">依据上节笔记摘要：{{coachNotePreview}}</text>
    <text class="info-p">{{oneDayTraining || '等待教练在课后记录笔记，即可看到基于上一节课的一日建议。'}}</text>
  </view>

  <view class="figma-card">
    <view class="card-hd">
      <text class="card-title">下一节课</text>
      <navigator class="link" url="/pages/member/coach-detail/coach-detail">去预约</navigator>
    </view>
    <view wx:if="{{nextClass}}">
      <text class="main-value">{{nextClass.appointmentDate}} {{nextClass.startTime}}-{{nextClass.endTime}}</text>
      <text class="sub">状态：已预约</text>
    </view>
    <text wx:else class="sub">暂无预约，建议先选择教练并预约时间。</text>
    <text class="sub">饮食建议：{{aiDietAdvice || '生成中...'}}</text>
  </view>

  <view class="figma-card">
    <text class="card-title">最近课程记录</text>
    <text class="sub" wx:if="{{!recentCourse}}">暂无课程记录</text>
    <view wx:if="{{recentCourse}}">
      <text class="sub" wx:if="{{recentCourse.createdAt}}">{{recentCourse.createdAt}}</text>
      <text class="summary">{{recentCourse.summary || '暂无总结，等待教练课后生成。'}}</text>
    </view>
  </view>

  <view class="tabbar-placeholder"></view>
  <view class="member-tabbar three">
    <view class="tab-item on" data-t="home" bindtap="onTabSwitch">
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-item" data-t="book" bindtap="onTabSwitch">
      <text class="tab-label">预约</text>
    </view>
    <view class="tab-item" data-t="mine" bindtap="onTabSwitch">
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
