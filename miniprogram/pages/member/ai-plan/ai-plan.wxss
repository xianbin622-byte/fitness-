.page {
  padding: 24rpx;
}

.metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.metric {
  flex: 1;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 16rpx;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  color: #111827;
  font-weight: 700;
}

.picker {
  padding: 16rpx 18rpx;
  margin-top: 10rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
}

.day {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef2f7;
}

.day-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.wline {
  display: block;
  font-size: 24rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.body-text {
  display: block;
  margin-top: 8rpx;
  color: #374151;
  line-height: 1.7;
  font-size: 26rpx;
  white-space: pre-wrap;
}

