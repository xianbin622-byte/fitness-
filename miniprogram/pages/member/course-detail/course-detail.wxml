<view class="page safe-bottom" wx:if="{{rec}}">
  <view class="card">
    <text class="title">课程总结</text>
    <text class="body">{{rec.summary || '—'}}</text>
  </view>
  <view class="card">
    <text class="title">问题点</text>
    <text class="body">{{rec.issues || '—'}}</text>
  </view>
  <view class="card">
    <text class="title">动作记录</text>
    <block wx:for="{{rec.exerciseItems}}" wx:key="id">
      <text class="line">{{item.actionName}} {{item.weight}}kg × {{item.reps}}次 × {{item.sets}}组</text>
    </block>
  </view>
  <view class="card">
    <text class="title">下次建议</text>
    <text class="body">{{rec.nextCoursePlan || '—'}}</text>
  </view>
  <view class="card">
    <text class="title">饮食建议</text>
    <text class="body">{{rec.dietAdvice || '—'}}</text>
  </view>
</view>
