.page {
  padding: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tile {
  display: block;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 170, 0.25);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.tile-title {
  display: block;
  color: #00d4aa;
  font-size: 32rpx;
  font-weight: 600;
}

.tile-desc {
  display: block;
  margin-top: 8rpx;
  color: #cde2ff;
  font-size: 24rpx;
}
