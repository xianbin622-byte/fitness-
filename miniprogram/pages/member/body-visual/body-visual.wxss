.page {
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}
.pad-v {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}
.title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12rpx;
}
.sub {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
}
.row-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.lab {
  font-size: 26rpx;
  color: #64748b;
}
.val {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}
.val.muted {
  color: #94a3b8;
  font-weight: 500;
}
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
