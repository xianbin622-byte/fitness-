@import "../../../styles/figma-fitness.wxss";

.figma-grad-hero.compact {
  padding-bottom: 24rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 6rpx;
  font-size: 24rpx;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.bar {
  width: 100%;
  height: 18rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #a8e6cf, #4caf50);
}

.badge-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.badge {
  background: #ecfdf5;
  color: #065f46;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
