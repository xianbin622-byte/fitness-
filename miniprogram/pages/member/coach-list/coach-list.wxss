@import "../../../styles/figma-fitness.wxss";

.figma-grad-hero.compact {
  padding-bottom: 24rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 6rpx;
  font-size: 24rpx;
}

.coach-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
}

.left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e0e7ff;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  margin-right: 16rpx;
}

.meta {
  min-width: 0;
}

.name {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}

.tag {
  font-size: 20rpx;
  color: #1d4ed8;
  background: #dbeafe;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.bind-btn {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}

.tabbar-placeholder {
  height: 150rpx;
}

.member-tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  z-index: 50;
}

.member-tabbar.three .tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
}

.member-tabbar .tab-item.on {
  background: #ecfdf5;
}

.member-tabbar .tab-label {
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 500;
}

.member-tabbar .tab-item.on .tab-label {
  color: #16a34a;
  font-weight: 700;
}
