.page {
  padding: 24rpx;
}

.coach-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
}

.left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e0e7ff;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  margin-right: 16rpx;
}

.meta {
  min-width: 0;
}

.name {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}

.tag {
  font-size: 20rpx;
  color: #1d4ed8;
  background: #dbeafe;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.bind-btn {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
