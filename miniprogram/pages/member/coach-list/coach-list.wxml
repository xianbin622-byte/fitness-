<view class="page figma-page-bg safe-bottom">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">选择教练</text>
    <text class="hero-sub">匹配最适合你的训练教练</text>
  </view>
  <block wx:for="{{list}}" wx:key="id">
    <view class="coach-card">
      <view class="left">
        <view class="avatar">
          <text>{{item.avatarText}}</text>
        </view>
        <view class="meta">
          <text class="name">{{item.nickname}}</text>
          <view class="tags">
            <text class="tag">私教</text>
            <text class="tag">可预约</text>
          </view>
          <text class="sub">手机号尾号 {{item.phone.slice(-4)}}</text>
        </view>
      </view>
      <button size="mini" class="bind-btn" data-id="{{item.id}}" bindtap="onBind">选择</button>
    </view>
  </block>
  <view wx:if="{{!list.length}}" class="sub empty">暂无教练，请先注册教练账号或由后台添加</view>

  <view class="tabbar-placeholder"></view>
  <view class="member-tabbar three">
    <view class="tab-item" data-t="home" bindtap="onTabSwitch">
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-item on" data-t="book" bindtap="onTabSwitch">
      <text class="tab-label">预约</text>
    </view>
    <view class="tab-item" data-t="mine" bindtap="onTabSwitch">
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
