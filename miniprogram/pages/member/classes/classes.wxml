<view class="page figma-page-bg safe-bottom">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">我的课程</text>
    <text class="hero-sub">即将上课 / 历史记录</text>
  </view>
  <block wx:for="{{list}}" wx:key="id">
    <view class="figma-card ap-card">
      <view class="row">
        <text class="d">{{item.appointmentDate}} {{item.startTime}}-{{item.endTime}}</text>
        <text class="status {{item.status === 'BOOKED' ? 'is-booked' : item.status === 'COMPLETED' ? 'is-done' : 'is-cancel'}}">
          {{item.status === 'BOOKED' ? '已预约' : item.status === 'CANCELLED' ? '已取消' : '已完成'}}
        </text>
      </view>
      <text class="sub">教练：{{item.coach.nickname}}</text>
      <button
        wx:if="{{item.status === 'BOOKED'}}"
        size="mini"
        class="btn-cancel {{item.canCancel ? '' : 'disabled'}}"
        disabled="{{!item.canCancel}}"
        data-id="{{item.id}}"
        bindtap="onCancel"
      >{{item.canCancel ? '取消预约' : '距开课不足1小时不可取消'}}</button>
    </view>
  </block>
  <view wx:if="{{!list.length}}" class="figma-card">
    <text class="sub">暂无预约记录</text>
  </view>

  <view class="tabbar-placeholder"></view>
  <view class="member-tabbar three">
    <view class="tab-item" data-t="home" bindtap="onTabSwitch">
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-item on" data-t="book" bindtap="onTabSwitch">
      <text class="tab-label">预约</text>
    </view>
    <view class="tab-item" data-t="mine" bindtap="onTabSwitch">
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
