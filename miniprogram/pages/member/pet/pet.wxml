<view class="page figma-page-bg safe-bottom">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">健身宠物</text>
    <text class="hero-sub">{{petName}} · Lv {{level}}</text>
  </view>
  <view class="figma-card pet-card">
    <text class="emoji">🐱</text>
    <text class="sub">现实训练可提升宠物等级与金币</text>
  </view>
  <view class="figma-card">
    <text class="line">健康值：{{health}}</text>
    <text class="line">能量值：{{energy}}</text>
    <text class="line">金币：{{coins}}</text>
  </view>
</view>
