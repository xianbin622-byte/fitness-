<view class="page safe-bottom">
  <block wx:for="{{list}}" wx:key="id">
    <view class="card">
      <text class="title">{{item.recordDateStr}}</text>
      <view class="grid2">
        <text>体重 {{item.weight || '-'}} kg</text>
        <text>体脂 {{item.bodyFat || '-'}} %</text>
        <text>腰围 {{item.waist || '-'}}</text>
        <text>臀围 {{item.hip || '-'}}</text>
      </view>
      <text class="sub" wx:if="{{item.notes}}">备注：{{item.notes}}</text>
    </view>
  </block>
</view>
