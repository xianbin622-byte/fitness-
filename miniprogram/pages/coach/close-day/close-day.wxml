<view class="page safe-bottom">
  <view class="card">
    <text class="title">选择要关闭或开放的日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="picker">{{date}}</view>
    </picker>
    <button class="btn-primary" bindtap="onClose">关闭该日全部</button>
    <button class="btn-ghost" bindtap="onOpen">重新开放该日</button>
  </view>
</view>
