.page {
  padding: 24rpx;
}

.picker {
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.area {
  width: 100%;
  min-height: 160rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(0, 212, 170, 0.35);
  border-radius: 12rpx;
  padding: 16rpx;
  color: #e8f1ff;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
