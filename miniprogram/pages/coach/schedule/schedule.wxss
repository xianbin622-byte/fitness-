@import "../../../styles/figma-fitness.wxss";

.catalog-wrap {
  padding-top: 8rpx;
  padding-bottom: 32rpx;
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.cat-row .left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.preset-card {
  border: 2rpx solid transparent;
}

.preset-card.on {
  border-color: #22c55e;
  background: #ecfdf5;
}

.cat-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.cat-meta {
  font-size: 24rpx;
  color: #6b7280;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.week-nav {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  color: #374151;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.day-list {
  padding: 0 24rpx 18rpx;
}

.day-card {
  margin-bottom: 18rpx;
}

.day-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.day-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.day-actions {
  display: flex;
  gap: 10rpx;
}

.action {
  background: #f3f4f6;
  color: #374151;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.action-primary {
  background: #eff6ff;
  color: #1d4ed8;
}

.action-green {
  background: #ecfdf5;
  color: #047857;
}

.closed-hint-figma {
  font-size: 24rpx;
  color: #ea580c;
  padding: 12rpx 0;
}

.slots-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.slot-chip {
  display: block;
  text-align: center;
  border-radius: 16rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}

.slot-chip.on {
  background: #08b241;
  color: #ffffff;
  border-color: #07a53c;
}

.slot-chip.off {
  background: #e5e7eb;
  color: #6b7280;
  border-color: #d1d5db;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-figma {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.sheet-title-figma {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 14rpx;
}

.form-row-figma {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.picker-col {
  flex: 1;
}

.picker-col.full {
  width: 100%;
}

.form-label-figma {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.picker-like-figma {
  padding: 18rpx 16rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
  color: #111827;
  border: 1rpx solid #e5e7eb;
  font-size: 28rpx;
}

.preview-box {
  background: #f7f8fb;
  border-radius: 20rpx;
  padding: 16rpx;
  margin: 18rpx 0;
}

.preview-title {
  font-size: 24rpx;
  color: #6b7280;
}

.preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.preview-chip {
  background: #dcfce7;
  color: #166534;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  border-radius: 10rpx;
  border: 1rpx solid transparent;
}

.preview-chip.on {
  background: #dcfce7;
  color: #166534;
  border-color: #bbf7d0;
}

.preview-chip.off {
  background: #f3f4f6;
  color: #9ca3af;
  border-color: #e5e7eb;
}

.sheet-confirm,
.btn-ghost-figma {
  margin-top: 14rpx;
}

.btn-ghost-figma {
  background: #fff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
}

.btn-ghost-figma.green {
  color: #047857;
  border-color: #22c55e;
}

.tabbar-placeholder {
  height: 150rpx;
}

.coach-tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  z-index: 60;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 20rpx;
}

.tab-item.on {
  background: #ecfdf5;
}

.tab-label {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 500;
}

.tab-item.on .tab-label {
  color: #16a34a;
  font-weight: 700;
}
