<view class="page figma-page-bg safe-bottom" wx:if="{{memberId}}">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">课后记录</text>
    <text class="hero-sub">{{memberLabel}}</text>
  </view>

  <view class="figma-card">
    <text class="hint">可手写要点，或按住录音。语音将自动转文字并追加到下方，保存后会员首页将显示「明日一日」建议。</text>
    <text class="hint hint-sub" wx:if="{{asrHint}}">{{asrHint}}</text>
    <view class="rec-row">
      <button
        class="rec-btn {{recording ? 'on' : ''}}"
        disabled="{{saving || uploading}}"
        bindtouchstart="onRecStart"
        bindtouchend="onRecEnd"
        bindtouchcancel="onRecCancel"
        hover-class="none"
      >
        {{ recording ? "松开结束" : "按住说话" }}
      </button>
      <text class="rec-tip" wx:if="{{uploading}}">正在上传并转写…</text>
    </view>
    <text class="field-label">笔记（将写入上一节课后反馈）</text>
    <textarea
      class="note-area"
      value="{{notes}}"
      placeholder="例如：今天深蹲腰代偿明显，下节课先壶铃箱式蹲找轨迹…"
      maxlength="4000"
      auto-height
      bindinput="onNotesInput"
    />
  </view>

  <button class="figma-btn-grad sub" disabled="{{saving || !canSave}}" bindtap="onSave">保存并生成会员明日建议</button>
</view>
