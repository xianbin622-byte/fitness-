.page {
  padding: 24rpx;
}

.area {
  width: 100%;
  min-height: 140rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(0, 212, 170, 0.35);
  border-radius: 12rpx;
  padding: 16rpx;
  color: #e8f1ff;
  box-sizing: border-box;
}

.row3 {
  display: flex;
  gap: 8rpx;
}

.sm {
  flex: 1;
  margin-bottom: 0;
}

.ex {
  margin-bottom: 16rpx;
}

.rec-hd {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.rec-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.btn-sm {
  padding: 0 20rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}
