<view class="page figma-page-bg safe-bottom">
  <view class="figma-grad-hero compact">
    <text class="figma-hero-h1">教练工作台</text>
    <text class="hero-sub">今日排课与会员状态</text>
  </view>

  <view class="figma-card">
    <text class="title-sm">今日课程统计</text>
    <view class="stats">
      <view class="stat">
        <text class="stat-label">总课程</text>
        <text class="stat-value">{{stats.total}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">待上课</text>
        <text class="stat-value">{{stats.booked}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">已完成</text>
        <text class="stat-value">{{stats.completed}}</text>
      </view>
    </view>
  </view>

  <view class="figma-card">
    <view class="row-hd">
      <text class="title-sm">今日预约</text>
      <text class="sub">实时同步预约状态</text>
    </view>
    <block wx:for="{{appts}}" wx:key="id">
      <view class="appt-card">
        <view>
          <text class="appt-time">{{item.startTime}}-{{item.endTime}}</text>
          <text class="sub">会员 {{item.member.nickname}}</text>
        </view>
        <text class="appt-status {{item.status === 'BOOKED' ? 'is-booked' : item.status === 'COMPLETED' ? 'is-done' : 'is-cancel'}}">
          {{item.status === 'BOOKED' ? '待上课' : item.status === 'COMPLETED' ? '已完成' : '已取消'}}
        </text>
      </view>
    </block>
    <text wx:if="{{!appts.length}}" class="sub">暂无预约</text>
  </view>

  <view class="tabbar-placeholder"></view>
  <view class="coach-tabbar">
    <view class="tab-item {{currentTab === 'home' ? 'on' : ''}}" data-tab="home" bindtap="onTabTap">
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-item {{currentTab === 'members' ? 'on' : ''}}" data-tab="members" bindtap="onTabTap">
      <text class="tab-label">会员</text>
    </view>
    <view class="tab-item {{currentTab === 'schedule' ? 'on' : ''}}" data-tab="schedule" bindtap="onTabTap">
      <text class="tab-label">课程</text>
    </view>
    <view class="tab-item {{currentTab === 'growth' ? 'on' : ''}}" data-tab="growth" bindtap="onTabTap">
      <text class="tab-label">成长</text>
    </view>
  </view>
</view>
