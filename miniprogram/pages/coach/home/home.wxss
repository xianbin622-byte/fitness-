@import "../../../styles/figma-fitness.wxss";

.figma-grad-hero.compact {
  padding-bottom: 24rpx;
}

.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 6rpx;
  font-size: 24rpx;
}

.title-sm {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.stat-label {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
}

.row-hd {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.appt-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.appt-time {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.appt-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.is-booked {
  color: #1d4ed8;
  background: #dbeafe;
}

.is-done {
  color: #047857;
  background: #d1fae5;
}

.is-cancel {
  color: #6b7280;
  background: #f3f4f6;
}

.quick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.qbtn {
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #065f46;
  font-size: 26rpx;
  font-weight: 500;
}

.qbtn.primary {
  background: #2563eb;
  color: #ffffff;
}

.tabbar-placeholder {
  height: 150rpx;
}

.coach-tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  z-index: 50;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 20rpx;
}

.tab-item.on {
  background: #ecfdf5;
}

.tab-label {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 500;
}

.tab-item.on .tab-label {
  color: #16a34a;
  font-weight: 700;
}
