.page {
  padding: 24rpx;
}

.title-sm {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.stat-label {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
}

.row-hd {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.appt-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.appt-time {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.appt-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.is-booked {
  color: #1d4ed8;
  background: #dbeafe;
}

.is-done {
  color: #047857;
  background: #d1fae5;
}

.is-cancel {
  color: #6b7280;
  background: #f3f4f6;
}

.quick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.qbtn {
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #eef2ff;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 500;
}

.qbtn.primary {
  background: #2563eb;
  color: #ffffff;
}
