@import "../../styles/figma-fitness.wxss";

.figma-grad-hero.compact {
  padding-bottom: 24rpx;
  margin: 0 0 20rpx;
}

.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 6rpx;
  font-size: 24rpx;
}

.figma-card .title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #111827;
}

.sub {
  color: #6b7280;
}

.figma-btn-ghost {
  margin: 24rpx 32rpx 0;
  background: #fff;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.tabbar-placeholder {
  height: 150rpx;
}

.member-tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  z-index: 50;
}

.member-tabbar.three .tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
}

.member-tabbar .tab-item.on {
  background: #ecfdf5;
}

.member-tabbar .tab-label {
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 500;
}

.member-tabbar .tab-item.on .tab-label {
  color: #16a34a;
  font-weight: 700;
}
