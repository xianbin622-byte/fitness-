.page {
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}
.hint {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.mono {
  font-family: ui-monospace, monospace;
  font-size: 24rpx;
  color: #0f172a;
}
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
