.page {
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}
.hint {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.lab {
  font-size: 26rpx;
  color: #334155;
}
.val {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
