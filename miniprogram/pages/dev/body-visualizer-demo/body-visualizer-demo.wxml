<view class="page safe-bottom">
  <view class="card">
    <text class="hint">拖动模型可旋转（带阻尼）。下方滑块仅本页演示用。</text>
    <body-visualizer
      height="{{height}}"
      weight="{{weight}}"
      bodyFat="{{bodyFat}}"
      waist="{{waist}}"
      hip="{{hip}}"
      thigh="{{thigh}}"
    />
  </view>
  <view class="card">
    <view class="row"><text class="lab">身高 cm</text><text class="val">{{height}}</text></view>
    <slider value="{{height}}" min="150" max="200" step="1" bindchange="onHeight" activeColor="#2563eb" />
    <view class="row"><text class="lab">体重 kg</text><text class="val">{{weight}}</text></view>
    <slider value="{{weight}}" min="40" max="120" step="1" bindchange="onWeight" activeColor="#2563eb" />
    <view class="row"><text class="lab">体脂 %</text><text class="val">{{bodyFat}}</text></view>
    <slider value="{{bodyFat}}" min="8" max="45" step="1" bindchange="onBodyFat" activeColor="#2563eb" />
    <view class="row"><text class="lab">腰围 cm</text><text class="val">{{waist}}</text></view>
    <slider value="{{waist}}" min="55" max="120" step="1" bindchange="onWaist" activeColor="#2563eb" />
    <view class="row"><text class="lab">臀围 cm</text><text class="val">{{hip}}</text></view>
    <slider value="{{hip}}" min="70" max="130" step="1" bindchange="onHip" activeColor="#2563eb" />
    <view class="row"><text class="lab">腿围 cm</text><text class="val">{{thigh}}</text></view>
    <slider value="{{thigh}}" min="40" max="80" step="1" bindchange="onThigh" activeColor="#2563eb" />
  </view>
</view>
