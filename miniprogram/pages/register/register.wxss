@import "../../styles/figma-fitness.wxss";

.page {
  min-height: 100vh;
}

.nav {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.nav-row {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.nav-back {
  width: 72rpx;
  font-size: 48rpx;
  color: #374151;
  line-height: 88rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.nav-placeholder {
  width: 72rpx;
}

.scroll {
  height: calc(100vh - 88rpx);
}

.main {
  padding: 12rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.logo-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  margin: 16rpx auto 20rpx;
  text-align: center;
  line-height: 120rpx;
  font-size: 70rpx;
  color: #fff;
  background: linear-gradient(145deg, #9be7cf, #4caf50);
  box-shadow: 0 8rpx 28rpx rgba(76, 175, 80, 0.28);
}

.headline {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
  text-align: center;
}

.subhead {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.field-grow {
  flex: 1;
  min-width: 0;
}

.send-code {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2563eb;
  padding: 16rpx 0;
  font-weight: 500;
}

.send-code-disabled {
  color: #9ca3af;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.line-input {
  width: 100%;
  font-size: 28rpx;
  color: #111827;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.picker-line {
  font-size: 28rpx;
  color: #111827;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.picker-line-static {
  color: #111827;
}

.role-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.4;
}

.ph {
  color: #9ca3af;
}

.btn-main {
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #9be7cf, #41b84f);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.to-login {
  margin-top: 36rpx;
  text-align: center;
}

.muted {
  font-size: 26rpx;
  color: #6b7280;
}

.gold {
  font-size: 26rpx;
  color: #16a34a;
  font-weight: 600;
  margin-left: 8rpx;
}

