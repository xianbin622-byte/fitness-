<view class="page safe-bottom">
  <view class="card">
    <picker mode="selector" range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="onRole">
      <view class="picker">角色：{{roles[roleIndex].label}}</view>
    </picker>
    <input class="input" placeholder="昵称" value="{{nickname}}" bindinput="onNick" />
    <input class="input" placeholder="手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" />
    <view class="row-sms">
      <input class="input input-sms" placeholder="短信验证码" type="number" maxlength="6" value="{{smsCode}}" bindinput="onSms" />
      <button class="btn-sms" disabled="{{countdown>0}}" bindtap="sendSms">{{countdown>0 ? countdown+'s' : '获取验证码'}}</button>
    </view>
    <text class="hint">先获取验证码；开发环境验证码见弹窗或终端日志</text>
    <button class="btn-primary" bindtap="onReg">注册</button>
    <navigator url="/pages/login/login" class="link">已有账号返回登录</navigator>
  </view>
</view>
