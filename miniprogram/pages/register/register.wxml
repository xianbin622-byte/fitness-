<view class="page figma-page-bg">
  <view class="nav" style="padding-top: {{statusBarH}}px">
    <view class="nav-row">
      <text class="nav-back" bindtap="goBack">‹</text>
      <text class="nav-title">创建账号</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="main">
      <view class="logo-box">✦</view>
      <text class="headline">加入 AI Fitness Coach OS</text>
      <text class="subhead">邮箱 + 邮箱验证码完成注册</text>

      <view class="form-card">
      <view class="field">
        <text class="label">昵称</text>
        <input
          class="line-input"
          placeholder="请输入昵称"
          placeholder-class="ph"
          value="{{nickname}}"
          bindinput="onNick"
        />
      </view>

      <view class="field">
        <text class="label">邮箱</text>
        <input
          class="line-input"
          type="text"
          placeholder="name@example.com"
          placeholder-class="ph"
          value="{{email}}"
          bindinput="onEmail"
        />
      </view>

      <view class="field field-row">
        <view class="field-grow">
          <text class="label">验证码</text>
          <input
            class="line-input"
            type="number"
            maxlength="6"
            placeholder="请输入6位验证码"
            placeholder-class="ph"
            value="{{smsCode}}"
            bindinput="onSms"
          />
        </view>
        <text class="send-code {{countdown>0 ? 'send-code-disabled' : ''}}" bindtap="sendEmailCode">
          {{countdown>0 ? countdown+'s' : '获取验证码'}}
        </text>
      </view>

      <button class="btn-main" bindtap="onReg">完成注册</button>
      </view>

      <view class="to-login" bindtap="goLogin">
        <text class="muted">已有账号？</text>
        <text class="gold">去登录</text>
      </view>
    </view>
  </scroll-view>

</view>
