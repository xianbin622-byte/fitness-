@import "../../styles/figma-fitness.wxss";

.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.hero-role {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #14532d;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.tile-wrap {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tile {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.07);
  position: relative;
}

.tile-t {
  display: block;
  color: #111827;
  font-weight: 700;
  font-size: 34rpx;
}

.tile-d {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  padding-right: 40rpx;
}

.tile-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #4caf50;
  font-size: 44rpx;
  font-weight: 300;
}

.actions {
  padding: 0 24rpx 30rpx;
}

.act {
  width: 100%;
}

.logout {
  background: #fff;
  border: 1rpx solid #fecaca;
  color: #be123c;
  border-radius: 20rpx;
}
