<view class="page safe-bottom">
  <view class="hero">
    <text class="hero-title">健身私教</text>
    <text class="hero-sub">会员预约 · 身体数据 · 课程闪记</text>
  </view>
  <view class="card">
    <input class="input" placeholder="手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" />
    <view class="row-sms">
      <input class="input input-sms" placeholder="短信验证码" type="number" maxlength="6" value="{{smsCode}}" bindinput="onSms" />
      <button class="btn-sms" disabled="{{countdown>0}}" bindtap="sendSms">{{countdown>0 ? countdown+'s' : '获取验证码'}}</button>
    </view>
    <input class="input" placeholder="密码（仅演示种子账号）" password value="{{password}}" bindinput="onPwd" />
    <text class="hint">优先使用验证码登录；种子账号 13800000001 / 123456 可填密码</text>
    <button class="btn-primary" bindtap="onLogin">登录</button>
    <navigator url="/pages/register/register" class="link">没有账号？去注册</navigator>
  </view>
</view>
