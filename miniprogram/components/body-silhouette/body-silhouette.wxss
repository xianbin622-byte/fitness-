.wrap {
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 212, 170, 0.25);
}

.figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.head {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #5dade2, #00d4aa);
  opacity: 0.9;
}

.torso {
  height: 140rpx;
  margin-top: 8rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(0, 212, 170, 0.7), rgba(0, 184, 148, 0.4));
}

.hip {
  height: 56rpx;
  margin-top: 4rpx;
  border-radius: 40rpx;
  background: rgba(93, 173, 226, 0.35);
}

.leg {
  width: 120rpx;
  height: 160rpx;
  margin-top: 8rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(0, 212, 170, 0.45), rgba(10, 22, 40, 0.8));
}

.female .torso {
  height: 120rpx;
}

.legend {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #8fa3c4;
  font-size: 24rpx;
}
