.wrap {
  position: relative;
  width: 100%;
  height: 320px;
  border-radius: 16px;
  overflow: hidden;
  background: linear-gradient(180deg, #e8eef5 0%, #f4f6f9 100%);
}
.cv {
  width: 100%;
  height: 320px;
  display: block;
}
.err {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
}
