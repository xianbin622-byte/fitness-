# 数据库：默认 SQLite 便于本地零依赖启动；生产可改为 PostgreSQL，见 README
DATABASE_URL="file:./dev.db"
# 生产必改：长随机串；用于鉴权
JWT_SECRET="请修改为随机长字符串"
# 选填：与 JWT 独立更稳妥；不填则回退为 JWT_SECRET 参与匿名 id 与导出
EXPORT_SALT=""
# 选填：仅当 AI_EXPORT_ANONYMIZE=1 时，导出中会对会员 id 做假名、去掉手机邮箱 openid
AI_EXPORT_ANONYMIZE="0"
# 选填：HTTP 拉全量数据集用于站外/离线训练；务必设长随机串且勿提交版本库
EXPORT_API_KEY=""
# 与小程序正式版、运维约定一致
NODE_ENV="development"
PORT=3000
# 小程序上传目录（相对 server 根目录）
UPLOAD_DIR="./uploads"
# 对外访问基础 URL（用于返回录音 URL；本地开发可填 http://本机IP:3000）
PUBLIC_BASE_URL="http://localhost:3000"

# 微信小程序：微信快捷登录（线上必填）。本地不配密钥时，NODE_ENV≠production 会自动 mock openid
WECHAT_APPID=""
WECHAT_APP_SECRET=""
# 可选：强制走 mock（=1）。生产环境务必配置真实密钥并勿设此项
WECHAT_DEV_MOCK=""

# 邮箱验证码（nodemailer）。不配置 SMTP_HOST 时仅打日志，开发环境接口仍返回 debugCode
# SMTP_SECURE=1 表示 465 等 SSL；587 通常配 SMTP_SECURE=0
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# 可选：接入 Kimi（Moonshot）生成式训练计划/总结
# 不配置则自动降级到规则引擎（确保功能可用、稳定）
KIMI_API_KEY=""
# 若使用大陆域名
KIMI_BASE_URL="https://api.moonshot.cn/v1"

# 可选：语音转文字（OpenAI 兼容接口）
# 若不填 ASR_API_KEY，将回退使用 KIMI_API_KEY；若仍无 key 则关闭自动转写
# 默认请求 ${ASR_BASE_URL}/audio/transcriptions，模型默认为 whisper-1
ASR_API_KEY=""
ASR_BASE_URL=""
ASR_MODEL="whisper-1"
ASR_LANGUAGE="zh"
